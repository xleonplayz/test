# Der Hafen, auf dem `--serve` lauscht (lokal und in compose).
# Auf der Cap gibt es keinen: dort wird der Dienst pro Anfrage gestartet.
PORT=8085

# Die IDENTITAET der Ziel-App, nicht ihre Adresse. `lly.app_call` nennt
# kein Host und keinen Port; wo `echo` liegt, entscheidet die Cap, und ob
# der Ruf erlaubt ist, entscheidet der Netz-Snapshot.
ECHO_APP=
