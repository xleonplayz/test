# Der Hafen, auf dem `--serve` lauscht (lokal und in compose).
# Auf der Cap gibt es keinen: dort wird der Dienst pro Anfrage gestartet.
PORT=8085

# Wo die Zahlungen liegen. Wie beim Bestelldienst: eine Zahlung entsteht
# zur Laufzeit und muss die Anfrage ueberleben, die sie ausgeloest hat.
PAYMENTS_STORE=/tmp/payments.store

# Ab welchem Betrag abgelehnt wird. Ein Zahlungsdienst, der immer zusagt,
# beweist nichts -- der Weg, auf dem eine Bestellung an der Zahlung
# scheitert, wird dann nie ausgefuehrt und faellt erst im Betrieb auf.
#
# Die Regel ist deterministisch, nicht zufaellig: zweimal dieselbe
# Anfrage gibt zweimal dieselbe Antwort, und ein Test kann die
# Ablehnung anfahren, ohne es hundertmal zu versuchen.
#
# Die zweite Ablehnungsregel braucht keine Variable: jede `method`, die
# auf `-decline` endet, wird abgelehnt (z. B. `card-decline`).
PAYMENTS_LIMIT_CENTS=100000
