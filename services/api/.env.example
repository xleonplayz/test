# Der Hafen, auf dem `--serve` lauscht (lokal und in compose).
PORT=8081

# Die zwei Schwestern — jede ueber ihre eigene Variable. Die Vorgaben sind
# die compose-Namen; auf der Cap traegt man hier die vergebenen Adressen
# ein (https://<slug>.dev.lilylabs.app).
INVENTORY_URL=http://inventory:8082
PRICING_URL=http://pricing:8083
