# Der Hafen, auf dem `--serve` lauscht (lokal und in compose).
# Auf der Cap gibt es keinen: dort wird der Dienst pro Anfrage gestartet.
PORT=8084

# Wo die Bestellungen liegen. Dieser Dienst ist der EINZIGE mit einem
# Speicher -- inventory und pricing antworten nur, eine Bestellung
# entsteht dagegen zur Laufzeit und muss die Anfrage ueberleben, die sie
# angelegt hat. Auf der Cap ist das keine Bequemlichkeit: dort wird die
# App pro Anfrage gestartet, ein Prozessspeicher waere sofort weg.
#
# Haelt der Wirt das Dateisystem nicht fest, ueberlebt eine Bestellung
# den Neustart nicht. `/health` nennt den Ort deshalb mit, damit man
# beim Nachsehen nicht raten muss.
ORDERS_STORE=/tmp/orders.store
