{
  "case": "B3",
  "apps": [
    {
      "path": "web",
      "name": "web",
      "runtime": "node",
      "exposed": true
    },
    {
      "path": "api",
      "name": "api",
      "runtime": "node",
      "exposed": false
    }
  ],
  "edges": [
    {
      "from": "web",
      "to": "api",
      "port": 8080
    }
  ],
  "local_environment": {
    "PEER_URL": "http://127.0.0.1:8081"
  },
  "platform_environment": {
    "PEER_URL": "http://api:8080"
  },
  "placement": "same project",
  "negative_control": "missing edge; no fallback to local application data"
}
